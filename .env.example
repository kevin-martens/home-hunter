# ==========================================
# 🏠 Apartment Hunter Configuration Example
# Copy this file to .env and fill in your settings
# ==========================================

# Search Criteria
# TARGET_LOCATIONS format is "city:postal_code,city2:postal_code2"
TARGET_LOCATIONS=gent:9000
PROPERTY_TYPES=apartment,house
TRANSACTION_TYPES=rent,buy
MIN_PRICE=800
MAX_PRICE=1100
MIN_BUY_PRICE=0
MAX_BUY_PRICE=450000
MIN_BEDROOMS=2

# Location/Proximity Filtering (Optional)
ENABLE_STATION_FILTER=false
STATION_NEAR_KEYWORDS=
STATION_FAR_KEYWORDS=

# Email Notifications (Gmail SMTP)
GMAIL_FROM=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_TO=recipient@example.com
EMAIL_CC=

# AI Quality Scoring (Optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
ENABLE_PHOTO_SCORING=true
